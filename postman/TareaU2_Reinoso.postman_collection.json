              "pm.test(\"Se crea un socio sin exponer su contraseña\", function () { const cuenta = pm.response.json(); pm.expect(cuenta.role).to.equal(\"USER\"); pm.expect(cuenta).not.to.have.property(\"password\"); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"socioId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
