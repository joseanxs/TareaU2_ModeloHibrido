{
  "info": {
    "name": "Tarea U2 · Gimnasio · Reinoso",
    "description": "Evidencia de la API híbrida del gimnasio. Desde la raíz, inicia Docker Compose y ejecuta `node postman/evidencia.js`. La colección apunta a 127.0.0.1:3100. Usa bases de evidencia separadas, crea los datos de cada ejecución y verifica su eliminación al final.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3100",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 · Preparar la ejecución",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/_evidencia/preparar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Se crea una ejecución temporal con fechas válidas\", function () { const datos = pm.response.json(); pm.expect(datos.id).to.match(/^[a-f0-9-]{36}$/); pm.expect(datos.fechaPasada < datos.fechaFutura).to.equal(true); });",
              "if (pm.response.code === 201) { Object.entries(pm.response.json()).forEach(([key, value]) => pm.collectionVariables.set(key, value)); pm.collectionVariables.set(\"idInexistente\", \"000000000000000000000000\"); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Obtener JWT · Administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"La respuesta contiene un JWT\", function () { pm.expect(pm.response.json().token).to.match(/^[^.]+\\.[^.]+\\.[^.]+$/); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"adminJwt\", pm.response.json().token); }"
            ]
          }
        }
      ]
    },
