# Copiar como .env en la raíz del proyecto (no se sube a GitHub)
PORT=3000
NODE_ENV=development

# PostgreSQL (Prisma) · contenedor espe-postgres
DATABASE_URL=postgresql://espe_user:espe_password@localhost:5432/espe_db

# JWT
JWT_SECRET=cambia_este_secreto

# MongoDB (Mongoose) · contenedor espe-mongo
MONGODB_URI=mongodb://espe_user:espe_password@localhost:27017/espe_mongo?authSource=admin
